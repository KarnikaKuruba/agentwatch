# Leave OPENAI_API_KEY blank to run the free, repeatable simulated agent.
# Set it to use a real LLM agent and the LLM judge layer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Agent mode: simulated (default when no key) or openai
AGENT_MODE=

# Only emails to these domains are considered internal.
ALLOWED_EMAIL_DOMAINS=acmecorp.com

# Optional: push alerts into a running ThreatWatch backend.
THREATWATCH_URL=
